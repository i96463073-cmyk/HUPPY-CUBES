{
  "name": "huppy-cubes",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huppy-hub-orders",
      "database_id": "67765968-522f-4e2f-8f38-22ccf2abbccb"
    }
  ],
  "vars": {
    "PESAPAL_MODE": "live",
    "PUBLIC_BASE_URL": "https://huppy-cubes.i96463073.workers.dev"
  }
}
